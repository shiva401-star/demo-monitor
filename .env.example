# Copy to .env for local demo (never commit .env)
SECRET_KEY=dev-only-change-me
FLASK_APP=app
FLASK_ENV=development
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5140
# Optional: override path to local SQLite (default: instance/monitoring.db)
# DATABASE_PATH=
# Optional: seed password used only when creating the admin user on first run
# DEMO_PASSWORD=
# Optional: skip real SSH (local UI demos / tests only)
# SKIP_SSH=false
